---
import {urlFor} from "../lib/image";
const {data}=Astro.props;

---


<header class="site-header">


<nav class="site-nav">


<a href="/" class="logo">

{
data.logo &&
<img 
  src={urlFor(data.logo)
    .width(200)
    .url()}
  alt={data.siteName}
/>
}

</a>



<ul class="nav-links">


{
data.headerMenu?.map(item=>(

<li>

<a href={item.url}>

{item.label}

</a>

</li>

))
}


<li>

<a 
href={data.headerButton.url}
class="nav-cta">

{data.headerButton.label}

</a>

</li>


</ul>


</nav>


</header>